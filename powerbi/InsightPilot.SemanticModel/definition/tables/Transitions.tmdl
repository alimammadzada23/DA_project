table Transitions

	column from_activity
		dataType: string
		summarizeBy: none
		sourceColumn: from_activity

	column to_activity
		dataType: string
		summarizeBy: none
		sourceColumn: to_activity

	column occurrences
		dataType: int64
		summarizeBy: none
		sourceColumn: occurrences

	column median_wait_hours
		dataType: double
		summarizeBy: none
		sourceColumn: median_wait_hours

	column p90_wait_hours
		dataType: double
		summarizeBy: none
		sourceColumn: p90_wait_hours

	partition Transitions = m
		mode: import
		source =
			Parquet.Document(File.Contents(DataFolder & "\transition_performance.parquet"))
