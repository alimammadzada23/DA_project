table Cases

	measure 'Items' = COALESCE(COUNTROWS(Cases), 0)

	measure 'Purchase Documents' = COALESCE(COUNTROWS(FILTER(VALUES(Cases[purchase_document]), NOT ISBLANK(Cases[purchase_document]))), 0)

	measure 'Median Observed Days' = MEDIAN(Cases[observed_span_days])

	measure 'P90 Observed Days' = PERCENTILEX.INC(FILTER(Cases, NOT ISBLANK(Cases[observed_span_days])), Cases[observed_span_days], 0.9)

	measure 'Repeat Cases' = COALESCE(COUNTROWS(FILTER(Cases, Cases[repeated_event_count] > 0)), 0)

	measure 'Repeat Rate' = DIVIDE([Repeat Cases], [Items])

	column case_id
		dataType: string
		summarizeBy: none
		sourceColumn: case_id

	column purchase_document
		dataType: string
		summarizeBy: none
		sourceColumn: purchase_document

	column matching_category
		dataType: string
		summarizeBy: none
		sourceColumn: matching_category

	column first_event
		dataType: dateTime
		summarizeBy: none
		sourceColumn: first_event

	column variant
		dataType: string
		summarizeBy: none
		sourceColumn: variant

	column observed_span_days
		dataType: double
		summarizeBy: none
		sourceColumn: observed_span_days

	column repeated_event_count
		dataType: int64
		summarizeBy: none
		sourceColumn: repeated_event_count

	column missing_timestamps
		dataType: int64
		summarizeBy: none
		sourceColumn: missing_timestamps

	column missing_activities
		dataType: int64
		summarizeBy: none
		sourceColumn: missing_activities

	column completion_status
		dataType: string
		summarizeBy: none
		sourceColumn: completion_status

	column 'Start Month' = IF(ISBLANK(Cases[first_event]), BLANK(), DATE(YEAR(Cases[first_event]), MONTH(Cases[first_event]), 1))
		dataType: dateTime
		formatString: yyyy-MM
		summarizeBy: none

	partition Cases = m
		mode: import
		source =
			Parquet.Document(File.Contents(DataFolder & "\case_metrics.parquet"))
